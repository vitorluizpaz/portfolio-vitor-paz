{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-vitor-paz",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "routes": [
    { "pattern": "vitorpaz.dev/*", "zone_name": "vitorpaz.dev" },
    { "pattern": "www.vitorpaz.dev/*", "zone_name": "vitorpaz.dev" }
  ],
  "assets": {
    "directory": "./dist"
  }
}
